{
  "name": "llmprobe",
  "version": "0.4.4",
  "description": "Conformance and capability test suite for LLM inference engines. Scores surface coverage, spec conformance, and whether the model is semi-capable.",
  "keywords": [
    "llm",
    "conformance",
    "openai",
    "inference",
    "benchmark",
    "mlx",
    "llama.cpp",
    "ollama"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddalcu/llmprobe.git"
  },
  "homepage": "https://github.com/ddalcu/llmprobe#readme",
  "bugs": {
    "url": "https://github.com/ddalcu/llmprobe/issues"
  },
  "bin": {
    "llmprobe": "bin/dist/llmprobe.mjs"
  },
  "files": [
    "bin/dist/llmprobe.mjs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prettier": "prettier",
    "build:cli": "esbuild bin/llmprobe.ts --bundle --platform=node --format=esm --target=node20 --outfile=bin/dist/llmprobe.mjs && chmod +x bin/dist/llmprobe.mjs",
    "prepare": "npm run build:cli",
    "prepublishOnly": "npm run build:cli",
    "probe": "npm run build:cli && node bin/dist/llmprobe.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "author": "David Dalcu <david.dalcu@gmail.com>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  }
}
